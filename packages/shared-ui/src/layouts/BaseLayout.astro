---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import type { MenuItem } from '../components/Header.astro';
import type { FooterColumn, ContactInfo, SocialLink } from '../components/Footer.astro';
import type { DesignTokens } from '@astro-fleet/config';
import { tokensToCSSVars } from '../utils/tokens.js';

export interface Props {
  /** Page title for SEO */
  title: string;
  /** Meta description for SEO */
  description: string;
  /** SEO keywords */
  keywords?: string[];
  /** JSON-LD structured data (one node or several; merged into SEOHead @graph) */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Canonical URL for the page */
  canonicalUrl?: string;
  /** Open Graph image URL */
  ogImage?: string;
  /** Alt text for og:image (defaults to page title) */
  ogImageAlt?: string;
  /** og:type — 'website' (default), 'article', etc. */
  ogType?: string;
  /** Twitter handle, with or without @ */
  twitterHandle?: string;
  /** Emits noindex and suppresses canonical */
  noindex?: boolean;
  /** RSS feed URL to advertise via <link rel="alternate"> */
  rssUrl?: string;
  /** Skip auto-generated WebSite/Organization JSON-LD (for pages that emit a full custom graph) */
  skipAutoJsonLd?: boolean;
  /** Navigation menu items */
  navigation: MenuItem[];
  /** Footer link columns */
  footerColumns: FooterColumn[];
  /** Contact information for footer */
  contactInfo?: ContactInfo;
  /** Social media links */
  socialLinks?: SocialLink[];
  /** Site name used in titles, header, footer */
  siteName: string;
  /** Design tokens for CSS custom properties */
  designTokens?: DesignTokens;
  /** Logo image source */
  logoSrc?: string;
  /** Logo alt text */
  logoAlt?: string;
  /** Footer tagline */
  tagline?: string;
  /** Header CTA text */
  /**
   * GA4 Measurement ID. Omit and no analytics renders at all.
   *
   * The tag loads only after the visitor accepts. See Analytics.astro for why
   * this is stricter than the usual Consent Mode v2 pattern.
   */
  gaId?: string;
  /** Where your analytics and cookies section lives. */
  privacyHref?: string;
  /** Site-wide search in the header. Needs the search index in the build. */
  search?: boolean;
  /** Placeholder for the search field. Name three things this site covers. */
  searchPlaceholder?: string;
  ctaText?: string;
  /** Header CTA link */
  ctaHref?: string;
  /** Extra head content */
  headSlot?: boolean;
  /** Body class */
  bodyClass?: string;
  /** Theme preference */
  theme?: 'light' | 'dark';
  /** html lang attribute */
  htmlLang?: string;
  /** html dir attribute */
  htmlDir?: 'ltr' | 'rtl';
  /** Open Graph / JSON-LD locale (e.g. en_US, ar_EG) */
  locale?: string;
  /** Skip-to-content link text */
  skipLinkText?: string;
  /** Footer copyright suffix after year and site name */
  rightsText?: string;
  /** Show Privacy / Terms / Sitemap links in the footer bottom bar */
  showLegalLinks?: boolean;
  /** When set, replaces the default footer legal row */
  legalLinks?: { label: string; href: string }[];
  /** Accessible labels for header chrome */
  navAriaLabel?: string;
  homeAriaLabel?: string;
  menuToggleAriaLabel?: string;
  mobileNavAriaLabel?: string;
  socialFollowLabel?: string;
}

const {
  title,
  description,
  keywords,
  structuredData,
  canonicalUrl,
  ogImage,
  ogImageAlt,
  ogType,
  twitterHandle,
  noindex,
  rssUrl,
  skipAutoJsonLd,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
  siteName,
  designTokens,
  logoSrc,
  logoAlt,
  tagline,
  gaId,
  privacyHref = '/privacy/',
  search,
  searchPlaceholder,
  ctaText,
  ctaHref,
  bodyClass = '',
  htmlLang = 'en',
  htmlDir = 'ltr',
  locale = 'en_US',
  skipLinkText = 'Skip to main content',
  rightsText,
  showLegalLinks = true,
  legalLinks,
  navAriaLabel,
  homeAriaLabel,
  menuToggleAriaLabel,
  mobileNavAriaLabel,
  socialFollowLabel,
} = Astro.props;

const sameAs = socialLinks?.map((s) => s.url).filter(Boolean);

const cssVars = designTokens ? tokensToCSSVars(designTokens) : '';
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir}>
  <head>
    <SEOHead
      title={title}
      description={description}
      keywords={keywords}
      structuredData={structuredData}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      twitterHandle={twitterHandle}
      noindex={noindex}
      rssUrl={rssUrl}
      siteName={siteName}
      logoUrl={logoSrc}
      sameAs={sameAs}
      skipAutoJsonLd={skipAutoJsonLd}
      locale={locale}
    />
    {/* CSS vars from tokensToCSSVars() — safe because source is static TypeScript config, not user input */}
    {cssVars && (
      <style set:html={`:root { ${cssVars} }`} />
    )}
    <style is:global>
      @layer base {
        /* ===== CSS Reset & Base ===== */
        *,
        *::before,
        *::after {
          box-sizing: border-box;
        }

        * {
          margin: 0;
        }

        html {
          -webkit-font-smoothing: antialiased;
          -moz-osx-font-smoothing: grayscale;
          text-rendering: optimizeLegibility;
          scroll-behavior: smooth;
        }

        body {
          font-family: var(--font-body, system-ui, -apple-system, sans-serif);
          color: var(--color-text, #1e293b);
          background-color: var(--color-background, #ffffff);
          line-height: 1.6;
          min-height: 100vh;
          display: flex;
          flex-direction: column;
        }

        img,
        picture,
        video,
        canvas,
        svg {
          display: block;
          max-width: 100%;
        }

        input,
        button,
        textarea,
        select {
          font: inherit;
        }

        p,
        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
          overflow-wrap: break-word;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
          font-family: var(--font-heading, 'Inter', sans-serif);
          line-height: 1.2;
        }

        a {
          color: inherit;
        }

        /* ===== Focus Visible ===== */
        :focus-visible {
          outline: 2px solid var(--color-accent, #00d4ff);
          outline-offset: 2px;
        }

        /* ===== Main Content ===== */
        main {
          flex: 1;
        }
      }

      @layer components {
        /* ===== Skip Link ===== */
        .skip-link {
          position: absolute;
          top: -100%;
          inset-inline-start: 1rem;
          padding: 0.75rem 1.5rem;
          background: var(--color-accent, #00d4ff);
          color: var(--color-primary, #0a0f1a);
          font-weight: 600;
          border-radius: 0 0 0.5rem 0.5rem;
          z-index: 9999;
          text-decoration: none;
          transition: top 0.2s ease;
        }

        .skip-link:focus {
          top: 0;
        }

        /* ===== Utility: Container ===== */
        .container {
          max-width: 1280px;
          margin: 0 auto;
          padding: 0 1.5rem;
        }

        /* ===== Utility: Section Spacing ===== */
        .section {
          padding: 4rem 1.5rem;
        }

        @media (min-width: 768px) {
          .section {
            padding: 5rem 2rem;
          }
        }

        /* ===== Utility: Section Header ===== */
        .section-header {
          text-align: center;
          max-width: 680px;
          margin: 0 auto 3rem;
        }

        .section-header__title {
          font-size: 2rem;
          font-weight: 800;
          color: var(--color-text-dark, #0f172a);
          margin-bottom: 0.75rem;
          letter-spacing: -0.02em;
        }

        .section-header__description {
          font-size: 1.0625rem;
          color: var(--color-text-muted, #64748b);
          line-height: 1.6;
        }

        @media (min-width: 768px) {
          .section-header__title {
            font-size: 2.75rem;
          }
        }
      }
    </style>
    <slot name="head" />
  </head>
  <body class={`theme-${Astro.props.theme || 'light'} ${bodyClass}`}>
    <a href="#main-content" class="skip-link">{skipLinkText}</a>

    <Header
      navigation={navigation}
      siteName={siteName}
      logoSrc={logoSrc}
      logoAlt={logoAlt}
      search={search}
      searchPlaceholder={searchPlaceholder}
      ctaText={ctaText}
      ctaHref={ctaHref}
      navAriaLabel={navAriaLabel}
      homeAriaLabel={homeAriaLabel}
      menuToggleAriaLabel={menuToggleAriaLabel}
      mobileNavAriaLabel={mobileNavAriaLabel}
    />

    <main id="main-content">
      <slot />
    </main>

    <Footer
      columns={footerColumns}
      contactInfo={contactInfo}
      socialLinks={socialLinks}
      siteName={siteName}
      tagline={tagline}
      rightsText={rightsText}
      showLegalLinks={showLegalLinks}
      legalLinks={legalLinks}
      socialFollowLabel={socialFollowLabel}
    />

    {/* Conditional, so a site with no gaId does not ship the analytics script
        at all. SiteSearch is rendered the same way in Header for the same
        reason: Astro tree-shakes a component that is never in the tree, but
        not one that renders nothing. */}
    {gaId && <Analytics id={gaId} policyHref={privacyHref} />}

    <slot name="footer-scripts" />
  </body>
</html>
