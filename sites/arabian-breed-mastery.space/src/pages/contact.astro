---
import BaseLayout from '@astro-fleet/shared-ui/src/layouts/BaseLayout.astro';
import Breadcrumb from '@astro-fleet/shared-ui/src/components/Breadcrumb.astro';
import ContactForm from '@astro-fleet/shared-ui/src/components/ContactForm.astro';
import FAQ from '@astro-fleet/shared-ui/src/components/FAQ.astro';
import {
  SITE_NAME,
  ALTERNATE_NAME,
  TAGLINE,
  LOGO_SRC,
  LOGO_ALT,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
  PHONE_DISPLAY,
  PHONE_E164,
  FOUNDING_YEAR,
  AREA_SERVED,
  address,
  OG_IMAGE_PATH,
  OG_IMAGE_ALT,
} from '../lib/site-config';
import { NILE_DUSK } from '../lib/tokens';

const contactFaq = [
  {
    question: 'How fast do you reply?',
    answer:
      'We aim to answer phone calls and enquiries within one business day. If you are writing about a specific horse, include breed details, age, and what you want to change.',
  },
  {
    question: 'Can I visit without a horse?',
    answer:
      'Yes — an initial conversation by phone is often enough to decide whether a session makes sense. In-person visits are arranged case by case.',
  },
  {
    question: 'How are sessions priced?',
    answer:
      'Rates depend on the horse and the work you want. We quote clearly by phone before you book — nothing is fixed until you agree.',
  },
];

const ogImageUrl = new URL(OG_IMAGE_PATH, Astro.site).href;
---

<BaseLayout
  title={`Contact — ${SITE_NAME}`}
  description={`Book a session with Arabian Breed Mastery in ${AREA_SERVED}. Call ${PHONE_DISPLAY}, or send an enquiry.`}
  keywords={['book horse training', 'Arabian Breed Mastery contact', 'Egypt equine']}
  {navigation}
  footerColumns={footerColumns}
  {contactInfo}
  {socialLinks}
  siteName={SITE_NAME}
  tagline={TAGLINE}
  logoSrc={LOGO_SRC}
  logoAlt={LOGO_ALT}
  ctaText="Book a session"
  ctaHref="/contact/"
  designTokens={NILE_DUSK}
  ogImage={ogImageUrl}
  ogImageAlt={OG_IMAGE_ALT}
  structuredData={{
    '@type': 'FAQPage',
    mainEntity: contactFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  }}
>
  <div class="container">
    <Breadcrumb
      items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
    />
  </div>

  <section class="abm-page-hero">
    <div class="container">
      <div class="abm-eyebrow">Contact</div>
      <h1>Book a session.</h1>
      <p>
        Call, or send a short enquiry. Tell us about your Arabian and what you
        want from the work — soft hand, calming a hot horse, or a more
        anatomical approach.
      </p>
    </div>
  </section>

  <section class="section abm-contact">
    <div class="container abm-contact__grid">
      <div class="abm-contact__info">
        <div class="abm-info">
          <div class="abm-info__label">Phone</div>
          <div class="abm-info__value">
            <a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a>
          </div>
        </div>

        <div class="abm-info">
          <div class="abm-info__label">Address</div>
          <div class="abm-info__value">
            {address.streetAddress}<br />
            {address.addressLocality}, {address.addressRegion}{' '}
            {address.postalCode}<br />
            {address.countryName}
          </div>
        </div>

        <div class="abm-info">
          <div class="abm-info__label">Practice</div>
          <div class="abm-info__value">
            {SITE_NAME}<br />
            <span lang="ru">{ALTERNATE_NAME}</span><br />
            Since {FOUNDING_YEAR}
          </div>
        </div>
      </div>

      <div class="abm-contact__form">
        <p class="abm-form-hint">
          Optional fields: use <strong>Company</strong> for your stable or yard,
          and <strong>Product interest</strong> for your horse’s name or the
          focus you want (soft hand, calming, anatomy). Prefer a phone call if
          you want a faster reply.
        </p>
        <ContactForm
          heading="Send an enquiry"
          description="We will follow up by phone. No public email is listed — calling is the fastest path."
          successText="Thank you. We will reply by phone within one working day."
          errorText={`We could not send that just now. Please call ${PHONE_DISPLAY} instead.`}
        />
      </div>
    </div>
  </section>

  <section class="section abm-contact-faq">
    <div class="container">
      <div class="abm-eyebrow">Before you write</div>
      <h2 class="abm-contact-faq__title">A few practical answers.</h2>
      <FAQ items={contactFaq} />
    </div>
  </section>
</BaseLayout>

<style>
  .abm-contact__grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .abm-contact__grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3.5rem;
      align-items: start;
    }
  }

  .abm-contact__info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .abm-form-hint {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 42rem;
    margin-bottom: 1.25rem;
  }

  .abm-form-hint strong {
    font-weight: 600;
    color: var(--color-text);
  }

  .abm-info__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .abm-info__value {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .abm-info__value a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .abm-contact-faq {
    background: var(--color-elevated);
    border-top: 1px solid var(--color-border);
  }

  .abm-contact-faq__title {
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }
</style>
