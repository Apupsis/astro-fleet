---
import { Image } from 'astro:assets';
import BaseLayout from '@astro-fleet/shared-ui/src/layouts/BaseLayout.astro';
import CTABlock from '@astro-fleet/shared-ui/src/components/CTABlock.astro';
import FAQ from '@astro-fleet/shared-ui/src/components/FAQ.astro';
import {
  SITE_NAME,
  SLOGAN_AR,
  TAGLINE,
  LOGO_SRC,
  LOGO_ALT,
  OG_IMAGE_PATH,
  OG_IMAGE_ALT,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
  PHONE_DISPLAY,
  PHONE_E164,
  FOUNDING_YEAR,
  AREA_SERVED,
  LOCATION_SHORT,
  LOCATION_REGION,
  postalAddressSchema,
  layoutChrome,
} from '../lib/site-config';
import { photos } from '../lib/images';
import { NILE_DUSK } from '../lib/tokens';

const ogImageUrl = new URL(OG_IMAGE_PATH, Astro.site).href;
const siteUrl = Astro.site!.href;

const pillars = [
  {
    title: 'عمل اليد الهادئ',
    body: 'تواصل هادئ عبر اللجام والجسد. قوة أقل، إجابات أوضح — ليتمكّن الحصان من التفكير بدل التصلّب.',
    image: photos.pillarHand,
    href: '/programs/ground-longe/',
  },
  {
    title: 'تهدئة الخيول الحارة',
    body: 'تقنيات للخيول العربية الحساسة والسريعة «الحارة»: خفض الإثارة، إعادة بناء الثقة، والحفاظ على اللياقة دون دوامة التصعيد.',
    image: photos.pillarCalm,
    href: '/programs/temperament-control/',
  },
  {
    title: 'التشريح في الجلسة',
    body: 'كل طلب يحترم بنية الحصان. نعمل مع الهيكل والتنفّس، لا ضد التوتر.',
    image: photos.pillarAnatomy,
    href: '/programs/seat-reins/',
  },
];

const faqItems = [
  {
    question: 'لمن هذه الممارسة؟',
    answer:
      'لمالكي وفرسان الخيول العربية الذين يريدون تواصلاً ألطف — خاصةً مع الخيول الحساسة أو «الحارة» التي تتصاعد تحت الضغط.',
  },
  {
    question: 'هل تعملون مع الخيول العربية فقط؟',
    answer:
      'Arabian Breed Mastery متخصصة في الحصان العربي. تُصمَّم الجلسات حول طبع هذه السلالة ولياقاتها وأنماط التوتر الشائعة لديها.',
  },
  {
    question: 'أين تُقام الجلسات؟',
    answer: `في ${AREA_SERVED}، ومقرّنا في ${LOCATION_REGION}. اتصل لتأكيد المكان والتوافر لحصانك.`,
  },
  {
    question: 'كيف أحجز؟',
    answer: `اتصل على ${PHONE_DISPLAY}، أو أرسل استفساراً من صفحة التواصل. سنرتّب وقتاً يناسبك ويناسب حصانك.`,
  },
];
---

<BaseLayout
  title={`${SITE_NAME} — عمل هادئ للخيول العربية`}
  description={`تساعد Arabian Breed Mastery مالكي وفرسان الخيول العربية عبر عمل اليد الهادئ وتقنيات تهدئة الخيول الحارة وجلسات تراعي التشريح. ${AREA_SERVED}، منذ ${FOUNDING_YEAR}.`}
  keywords={[
    'خيول عربية',
    'عمل اليد الهادئ',
    'خيول حارة',
    'تدريب خيول مصر',
    'السلالة العربية',
    SLOGAN_AR,
  ]}
  {navigation}
  footerColumns={footerColumns}
  {contactInfo}
  {socialLinks}
  siteName={SITE_NAME}
  tagline={TAGLINE}
  logoSrc={LOGO_SRC}
  logoAlt={LOGO_ALT}
  ogImage={ogImageUrl}
  ogImageAlt={OG_IMAGE_ALT}
  designTokens={NILE_DUSK}
  htmlLang={layoutChrome.htmlLang}
  htmlDir={layoutChrome.htmlDir}
  locale={layoutChrome.locale}
  skipLinkText={layoutChrome.skipLinkText}
  ctaText={layoutChrome.ctaText}
  ctaHref={layoutChrome.ctaHref}
  rightsText={layoutChrome.rightsText}
  showLegalLinks={layoutChrome.showLegalLinks}
  legalLinks={layoutChrome.legalLinks}
  navAriaLabel={layoutChrome.navAriaLabel}
  homeAriaLabel={layoutChrome.homeAriaLabel}
  menuToggleAriaLabel={layoutChrome.menuToggleAriaLabel}
  mobileNavAriaLabel={layoutChrome.mobileNavAriaLabel}
  structuredData={[
    {
      '@type': 'LocalBusiness',
      '@id': new URL('/#localbusiness', Astro.site).href,
      name: SITE_NAME,
      alternateName: SLOGAN_AR,
      description: `عمل اليد الهادئ، وتقنيات تهدئة الخيول العربية الحارة، وجلسات تراعي التشريح في ${AREA_SERVED}.`,
      url: siteUrl,
      image: ogImageUrl,
      foundingDate: FOUNDING_YEAR,
      telephone: PHONE_E164,
      address: postalAddressSchema(),
      areaServed: AREA_SERVED,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ]}
>
  <section class="abm-hero" aria-label="مقدمة">
    <Image
      src={photos.heroDusk.src}
      alt=""
      class="abm-hero__photo"
      widths={[800, 1200, 1800, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={80}
    />
    <div class="abm-hero__overlay" aria-hidden="true"></div>
    <div class="abm-hero__grain" aria-hidden="true"></div>
    <div class="abm-hero__inner">
      <p class="abm-hero__brand brand-latin">{SITE_NAME}</p>
      <p class="abm-hero__alt">{SLOGAN_AR}</p>
      <h1 class="abm-hero__title">
        أيدٍ هادئة<br />
        <em>للخيول الحارة.</em>
      </h1>
      <p class="abm-hero__lede">
        عمل هادئ باللجام وتقنيات تهدئة للخيول العربية — مبنية على التشريح لا على القوة.
        لمالكي وفرسان يريدون حواراً أوضح مع شريك حسّاس.
      </p>
      <div class="abm-hero__actions">
        <a href="/contact-us/" class="abm-btn abm-btn--primary">احجز جلسة</a>
        <a href="/programs/" class="abm-btn abm-btn--ghost abm-btn--on-dark"
          >البرامج</a
        >
      </div>
      <p class="abm-hero__meta">{AREA_SERVED} · تأسست {FOUNDING_YEAR}</p>
    </div>
  </section>

  <section class="section abm-intro">
    <div class="container abm-intro__grid">
      <div>
        <div class="abm-eyebrow">الممارسة</div>
        <h2>عمل يخفض الضجيج.</h2>
      </div>
      <p>
        الخيول العربية تشعر بكل شيء. عندما تكون اليد قاسية أو الطلب غير واضح،
        تتقدّم أو تتصلّب أو تنغلق. نعلّم التماس الهادئ والتوقيت ووعي الجسد حتى
        يصبح «الحار» منتبهاً — لا منفجراً.
      </p>
    </div>
  </section>

  <section class="section abm-pillars">
    <div class="container">
      <div class="abm-eyebrow">ثلاثة محاور</div>
      <h2 class="abm-pillars__title">ما يطلبه المالكون.</h2>
      <div class="abm-pillars__list">
        {
          pillars.map((p, i) => (
            <a href={p.href} class="abm-pillar">
              <div class="abm-pillar__media">
                <Image
                  src={p.image.src}
                  alt={p.image.alt}
                  class="abm-pillar__img"
                  widths={[400, 640, 800]}
                  sizes="(min-width: 768px) 30vw, 100vw"
                  loading="lazy"
                  quality={75}
                />
              </div>
              <span class="abm-pillar__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </a>
          ))
        }
      </div>
      <p class="abm-pillars__link">
        <a href="/programs/">كل البرامج — بما فيها التجميع في الحلبة ←</a>
      </p>
    </div>
  </section>

  <section class="abm-strip" aria-label="الموقع والتأسيس">
    <div class="container abm-strip__row">
      <div>
        <span class="abm-strip__label">المقر</span>
        <strong>{LOCATION_SHORT}</strong>
      </div>
      <div>
        <span class="abm-strip__label">الممارسة منذ</span>
        <strong>{FOUNDING_YEAR}</strong>
      </div>
      <div>
        <span class="abm-strip__label">لـ</span>
        <strong>مالكي وفرسان الخيول العربية</strong>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="abm-eyebrow">أسئلة</div>
      <FAQ
        items={faqItems}
        heading="قبل أن تحجز."
        ariaLabel={layoutChrome.faqAriaLabel}
      />
    </div>
  </section>

  <CTABlock
    heading="أدخل حصانك في عمل أكثر هدوءاً."
    description="أخبرنا عن حصانك العربي وما تريد تغييره. سنرد عبر الهاتف لترتيب جلسة."
    primaryButton={{ text: 'احجز جلسة', href: '/contact-us/' }}
    secondaryButton={{ text: 'عنّا', href: '/about-us/' }}
  />
</BaseLayout>

<style>
  .abm-hero {
    position: relative;
    min-height: min(92svh, 820px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #f3efe8;
    isolation: isolate;
  }

  .abm-hero__photo {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .abm-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        180deg,
        rgba(12, 20, 34, 0.55) 0%,
        rgba(12, 20, 34, 0.45) 40%,
        rgba(12, 20, 34, 0.82) 100%
      ),
      linear-gradient(
        270deg,
        rgba(12, 20, 34, 0.55) 0%,
        rgba(12, 20, 34, 0.2) 55%,
        rgba(12, 20, 34, 0.35) 100%
      );
  }

  .abm-hero__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.12;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  .abm-hero__inner {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
  }

  .abm-hero__brand {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    color: #f3efe8;
    margin-bottom: 0.25rem;
    animation: abm-rise 0.9s ease both;
  }

  .abm-hero__alt {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: color-mix(in srgb, #f3efe8 55%, transparent);
    margin-bottom: 1.75rem;
    animation: abm-rise 0.9s ease 0.08s both;
  }

  .abm-hero__title {
    font-size: clamp(2.75rem, 8vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #f3efe8;
    margin-bottom: 1.25rem;
    max-width: 14ch;
    animation: abm-rise 0.9s ease 0.14s both;
  }

  .abm-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: color-mix(in srgb, #9ec5c3 90%, #f3efe8);
  }

  .abm-hero__lede {
    font-size: 1.125rem;
    line-height: 1.7;
    color: color-mix(in srgb, #f3efe8 78%, transparent);
    max-width: 38rem;
    margin-bottom: 2rem;
    animation: abm-rise 0.9s ease 0.22s both;
  }

  .abm-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    animation: abm-rise 0.9s ease 0.3s both;
  }

  .abm-hero__meta {
    font-size: 0.875rem;
    color: color-mix(in srgb, #f3efe8 45%, transparent);
    animation: abm-rise 0.9s ease 0.36s both;
  }

  @keyframes abm-rise {
    from {
      opacity: 0;
      transform: translateY(1.1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .abm-hero__brand,
    .abm-hero__alt,
    .abm-hero__title,
    .abm-hero__lede,
    .abm-hero__actions,
    .abm-hero__meta {
      animation: none;
    }
  }

  .abm-intro__grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .abm-intro__grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 3rem;
      align-items: end;
    }
  }

  .abm-intro h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
  }

  .abm-intro p {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .abm-pillars {
    background: var(--color-elevated);
    border-block: 1px solid var(--color-border);
  }

  .abm-pillars__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    margin-bottom: 2.5rem;
  }

  .abm-pillars__list {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .abm-pillars__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .abm-pillar__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: color-mix(in srgb, var(--color-border) 55%, transparent);
    margin-bottom: 1.25rem;
    min-width: 0;
  }

  .abm-pillar__img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .abm-pillar {
    display: block;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .abm-pillar:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .abm-pillar:hover h3 {
    color: var(--color-accent);
  }

  .abm-pillar__num {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .abm-pillar h3 {
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .abm-pillar p {
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .abm-pillars__link {
    margin-top: 2.5rem;
  }

  .abm-pillars__link a {
    font-weight: 600;
  }

  .abm-strip {
    background: var(--color-primary);
    color: #f3efe8;
    padding: 2.5rem 1.5rem;
  }

  .abm-strip__row {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .abm-strip__row {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .abm-strip__label {
    display: block;
    font-size: 0.8125rem;
    color: color-mix(in srgb, #f3efe8 50%, transparent);
    margin-bottom: 0.35rem;
  }

  .abm-strip strong {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 500;
  }
</style>
