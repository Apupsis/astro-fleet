---
import BaseLayout from '@astro-fleet/shared-ui/src/layouts/BaseLayout.astro';
import {
  SITE_NAME,
  TAGLINE,
  LOGO_SRC,
  LOGO_ALT,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
  OG_IMAGE_PATH,
  OG_IMAGE_ALT,
  layoutChrome,
} from '../lib/site-config';
import { NILE_DUSK } from '../lib/tokens';
---

<BaseLayout
  title={`الصفحة غير موجودة — ${SITE_NAME}`}
  description="هذه الصفحة غير موجودة على Arabian Breed Mastery."
  noindex={true}
  {navigation}
  footerColumns={footerColumns}
  {contactInfo}
  {socialLinks}
  siteName={SITE_NAME}
  tagline={TAGLINE}
  logoSrc={LOGO_SRC}
  logoAlt={LOGO_ALT}
  designTokens={NILE_DUSK}
  ogImage={new URL(OG_IMAGE_PATH, Astro.site).href}
  ogImageAlt={OG_IMAGE_ALT}
  htmlLang={layoutChrome.htmlLang}
  htmlDir={layoutChrome.htmlDir}
  locale={layoutChrome.locale}
  skipLinkText={layoutChrome.skipLinkText}
  ctaText={layoutChrome.ctaText}
  ctaHref={layoutChrome.ctaHref}
  rightsText={layoutChrome.rightsText}
  showLegalLinks={layoutChrome.showLegalLinks}
  legalLinks={layoutChrome.legalLinks}
  navAriaLabel={layoutChrome.navAriaLabel}
  homeAriaLabel={layoutChrome.homeAriaLabel}
  menuToggleAriaLabel={layoutChrome.menuToggleAriaLabel}
  mobileNavAriaLabel={layoutChrome.mobileNavAriaLabel}
>
  <section class="not-found">
    <div class="not-found__container">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">الصفحة غير موجودة</h1>
      <p class="not-found__message">
        هذا المسار ليس جزءاً من Arabian Breed Mastery. عد إلى الرئيسية، أو افتح
        صفحة التواصل لحجز جلسة.
      </p>
      <div class="not-found__actions">
        <a href="/" class="abm-btn abm-btn--primary">إلى الرئيسية</a>
        <a href="/contact-us/" class="abm-btn abm-btn--ghost">احجز جلسة</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .not-found__container {
    max-width: 480px;
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-size: 5.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-border);
    letter-spacing: -0.04em;
    margin-bottom: 0.5rem;
  }

  .not-found__title {
    font-size: 2rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .not-found__message {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 auto 2rem;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
