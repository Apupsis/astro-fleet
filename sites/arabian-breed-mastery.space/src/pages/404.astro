---
import BaseLayout from '@astro-fleet/shared-ui/src/layouts/BaseLayout.astro';
import {
  SITE_NAME,
  TAGLINE,
  LOGO_SRC,
  LOGO_ALT,
  navigation,
  footerColumns,
  contactInfo,
  socialLinks,
} from '../lib/site-config';
import { NILE_DUSK } from '../lib/tokens';
---

<BaseLayout
  title={`Page not found — ${SITE_NAME}`}
  description="This page does not exist on Arabian Breed Mastery."
  noindex={true}
  {navigation}
  footerColumns={footerColumns}
  {contactInfo}
  {socialLinks}
  siteName={SITE_NAME}
  tagline={TAGLINE}
  logoSrc={LOGO_SRC}
  logoAlt={LOGO_ALT}
  ctaText="Book a session"
  ctaHref="/contact/"
  designTokens={NILE_DUSK}
>
  <section class="not-found">
    <div class="not-found__container">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">Page not found</h1>
      <p class="not-found__message">
        This path is not part of Arabian Breed Mastery. Head home, or open the
        contact page to book a session.
      </p>
      <div class="not-found__actions">
        <a href="/" class="abm-btn abm-btn--primary">Go home</a>
        <a href="/contact/" class="abm-btn abm-btn--ghost">Book a session</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .not-found__container {
    max-width: 480px;
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-size: 5.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-border);
    letter-spacing: -0.04em;
    margin-bottom: 0.5rem;
  }

  .not-found__title {
    font-size: 2rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .not-found__message {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 auto 2rem;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
